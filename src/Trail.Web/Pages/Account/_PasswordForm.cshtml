@model Trail.Web.Pages.Account.SettingsModel.PasswordInputModel?
@{
    ViewData.TemplateInfo.HtmlFieldPrefix = "PasswordInput";
}

<div id="password-form-container">
    <form method="post"
          asp-page="/Account/Settings"
          asp-page-handler="Password"
          hx-post="/Account/Settings?handler=Password"
          hx-target="#password-form-container"
          hx-swap="outerHTML"
          class="flex flex-col gap-4">

        <div asp-validation-summary="ModelOnly" class="alert alert-error text-sm" role="alert"></div>

        <div class="form-control">
            <label asp-for="CurrentPassword" class="label">
                <span class="label-text font-medium">@SharedLocalizer["CurrentPassword"]</span>
            </label>
            <input asp-for="CurrentPassword" asp-error-span
                   type="password"
                   class="input input-bordered w-full"
                   placeholder="@SharedLocalizer["CurrentPasswordPlaceholder"]"
                   autocomplete="current-password"
                   required />
            <span asp-validation-for="CurrentPassword" class="text-xs text-error mt-1"></span>
        </div>

        <div class="form-control">
            <label asp-for="NewPassword" class="label">
                <span class="label-text font-medium">@SharedLocalizer["NewPassword"]</span>
            </label>
            <input asp-for="NewPassword" asp-error-span
                   type="password"
                   class="input input-bordered w-full"
                   placeholder="@SharedLocalizer["NewPasswordPlaceholder"]"
                   autocomplete="new-password"
                   required />
            <span asp-validation-for="NewPassword" class="text-xs text-error mt-1"></span>
        </div>

        <div class="form-control">
            <label asp-for="ConfirmPassword" class="label">
                <span class="label-text font-medium">@SharedLocalizer["ConfirmNewPassword"]</span>
            </label>
            <input asp-for="ConfirmPassword" asp-error-span
                   type="password"
                   class="input input-bordered w-full"
                   placeholder="@SharedLocalizer["ConfirmNewPasswordPlaceholder"]"
                   autocomplete="new-password"
                   required />
            <span asp-validation-for="ConfirmPassword" class="text-xs text-error mt-1"></span>
        </div>

        <div class="form-control mt-2">
            <button type="submit" class="btn btn-primary self-start">
                @SharedLocalizer["ChangePassword"]
            </button>
        </div>
    </form>
</div>
