@page
@model Trail.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = SharedLocalizer["ForgotPasswordTitle"];
}

<div class="mx-auto max-w-md">
    <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
            @if (Model.Sent)
            {
                <div class="alert alert-success" role="status">
                    <icon name="check-circle" class="size-6 shrink-0" />
                    <div>
                        <h1 class="font-bold">@SharedLocalizer["ForgotPasswordTitle"]</h1>
                        <p class="text-sm">@SharedLocalizer["PasswordResetSent"]</p>
                    </div>
                </div>

                <div class="mt-6">
                    <a asp-page="/Account/Login" class="btn btn-primary w-full">
                        @SharedLocalizer["GoToLogin"]
                    </a>
                </div>
            }
            else
            {
                <h1 class="card-title text-2xl font-bold">@SharedLocalizer["ForgotPasswordHeading"]</h1>
                <p class="mt-2 text-sm text-base-content/80">@SharedLocalizer["ForgotPasswordInstructions"]</p>

                <form method="post" class="mt-4 flex flex-col gap-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-error text-sm" role="alert"></div>

                    <div class="form-control">
                        <label asp-for="Email" class="label">
                            <span class="label-text font-medium">@SharedLocalizer["Email"]</span>
                        </label>
                        <input asp-for="Email"
                               type="email"
                               class="input input-bordered w-full"
                               placeholder="@SharedLocalizer["EmailPlaceholder"]"
                               autocomplete="email"
                               required />
                        <span asp-validation-for="Email" class="text-xs text-error mt-1"></span>
                    </div>

                    <div class="form-control mt-2">
                        <button type="submit" class="btn btn-primary w-full">
                            @(ModelState.IsValid ? SharedLocalizer["SendPasswordResetLink"] : SharedLocalizer["Retry"])
                        </button>
                    </div>
                </form>

                <div class="divider my-4"></div>

                <p class="text-center text-sm text-base-content/80">
                    <a asp-page="/Account/Login" class="link link-primary font-medium">
                        @SharedLocalizer["GoToLogin"]
                    </a>
                </p>
            }
        </div>
    </div>
</div>
