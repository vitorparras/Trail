@model Trail.Web.Pages.Account.SettingsModel.SettingsInputModel?
@{
    ViewData.TemplateInfo.HtmlFieldPrefix = "SettingsInput";
}

<div id="settings-form-container">
    <form method="post"
          asp-page="/Account/Settings"
          asp-page-handler="Settings"
          hx-post="/Account/Settings?handler=Settings"
          hx-target="#settings-form-container"
          hx-swap="outerHTML"
          class="flex flex-col gap-4">

        <div asp-validation-summary="All" class="alert alert-error text-sm" role="alert"></div>

        <div class="form-control">
            <label asp-for="TimeZoneId" class="label">
                <span class="label-text font-medium">@SharedLocalizer["TimeZone"]</span>
            </label>
            <select asp-for="TimeZoneId" class="select select-bordered w-full">
                @foreach (var tz in Trail.Web.Pages.Account.SettingsModel.AvailableTimeZones)
                {
                    <option value="@tz" selected="@(Model?.TimeZoneId == tz ? "selected" : null)">@tz</option>
                }
            </select>
            <span asp-validation-for="TimeZoneId" class="text-xs text-error mt-1"></span>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="form-control">
                <label asp-for="PomodoroFocusMinutes" class="label">
                    <span class="label-text font-medium">@SharedLocalizer["PomodoroFocusMinutes"]</span>
                </label>
                <input asp-for="PomodoroFocusMinutes"
                       type="number"
                       min="1"
                       max="180"
                       class="input input-bordered w-full"
                       required />
                <span asp-validation-for="PomodoroFocusMinutes" class="text-xs text-error mt-1"></span>
            </div>

            <div class="form-control">
                <label asp-for="PomodoroBreakMinutes" class="label">
                    <span class="label-text font-medium">@SharedLocalizer["PomodoroBreakMinutes"]</span>
                </label>
                <input asp-for="PomodoroBreakMinutes"
                       type="number"
                       min="1"
                       max="60"
                       class="input input-bordered w-full"
                       required />
                <span asp-validation-for="PomodoroBreakMinutes" class="text-xs text-error mt-1"></span>
            </div>
        </div>

        <div class="form-control mt-2">
            <button type="submit" class="btn btn-primary self-start">
                @SharedLocalizer["SaveSettings"]
            </button>
        </div>
    </form>
</div>
