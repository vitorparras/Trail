@using Trail.Web.Results
@model IReadOnlyList<Trail.Application.Abstractions.DeletionImpactItem>
@inject IStringLocalizerFactory LocalizerFactory
@if (Model.Count > 0)
{
    <ul class="list-disc list-inside text-sm text-base-content/70 space-y-1 mb-4" data-deletion-impact>
        @foreach (var item in Model)
        {
            <li data-code="@item.Code" data-count="@item.Count">@LocalizerFactory.LocalizeCount(item.Code, item.Count)</li>
        }
    </ul>
}
