@model Trail.Web.Pages.Plans.AddSubjectFormModel
@{
    const string errorsId = "add-subject-errors";
    var errors = FormErrors.For(ViewData.ModelState, Model.ShowErrors, PlanFormErrors.NameField);
    var nameInvalid = FormErrors.HasErrors(ViewData.ModelState, Model.ShowErrors, PlanFormErrors.NameField);
}

<form method="post" aria-labelledby="add-subject-heading" asp-page-handler="AddSubject" asp-route-planId="@Model.PlanId" class="flex flex-wrap items-center gap-2">
    <input type="hidden" name="expectedPlanVersion" value="@Model.PlanVersion" />
    <input type="text"
           name="name"
           value="@Model.Name"
           placeholder="@SharedLocalizer["SubjectName"]"
           aria-label="@SharedLocalizer["SubjectName"]"
           aria-invalid="@(nameInvalid ? "true" : null)"
           aria-describedby="@(nameInvalid ? errorsId : null)"
           class="input input-bordered input-sm flex-1 min-w-[140px] @(nameInvalid ? "input-error" : null)"
           required />
    <select name="sectionId" aria-label="@SharedLocalizer["SubjectSection"]" class="select select-bordered select-sm">
        <option value="">@SharedLocalizer["UnassignedSubjects"]</option>
        @foreach (var sectionOption in Model.Sections)
        {
            <!option value="@sectionOption.Id.Value" @(Model.SectionId == sectionOption.Id.Value ? "selected" : null)>@sectionOption.Name</!option>
        }
    </select>
    <button type="submit" class="btn btn-sm btn-primary">@SharedLocalizer["AddSubject"]</button>
    <partial name="_FormErrors" model="new FormErrorList(errorsId, errors)" />
</form>
