@page
@model Trail.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = SharedLocalizer["ResetPasswordTitle"];
}

<div class="mx-auto max-w-md">
    <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
            @if (Model.ResetComplete)
            {
                <div class="alert alert-success" role="status">
                    <icon name="check-circle" class="size-6 shrink-0" />
                    <div>
                        <h1 class="font-bold">@SharedLocalizer["ResetPasswordSuccessTitle"]</h1>
                        <p class="text-sm">@SharedLocalizer["ResetPasswordSuccessMessage"]</p>
                    </div>
                </div>

                <div class="mt-6">
                    <a asp-page="/Account/Login" class="btn btn-primary w-full">
                        @SharedLocalizer["GoToLogin"]
                    </a>
                </div>
            }
            else
            {
                <h1 class="card-title text-2xl font-bold">@SharedLocalizer["ResetPasswordHeading"]</h1>

                <form method="post" class="mt-4 flex flex-col gap-4">
                    <div asp-validation-summary="All" class="alert alert-error text-sm" role="alert"></div>

                    <input type="hidden" asp-for="Input.UserId" />
                    <input type="hidden" asp-for="Input.Token" />

                    <div class="form-control">
                        <label asp-for="Input.NewPassword" class="label">
                            <span class="label-text font-medium">@SharedLocalizer["NewPassword"]</span>
                        </label>
                        <input asp-for="Input.NewPassword"
                               type="password"
                               class="input input-bordered w-full"
                               placeholder="@SharedLocalizer["NewPasswordPlaceholder"]"
                               autocomplete="new-password"
                               required />
                        <span asp-validation-for="Input.NewPassword" class="text-xs text-error mt-1"></span>
                    </div>

                    <div class="form-control">
                        <label asp-for="Input.ConfirmNewPassword" class="label">
                            <span class="label-text font-medium">@SharedLocalizer["ConfirmNewPassword"]</span>
                        </label>
                        <input asp-for="Input.ConfirmNewPassword"
                               type="password"
                               class="input input-bordered w-full"
                               placeholder="@SharedLocalizer["ConfirmNewPasswordPlaceholder"]"
                               autocomplete="new-password"
                               required />
                        <span asp-validation-for="Input.ConfirmNewPassword" class="text-xs text-error mt-1"></span>
                    </div>

                    <div class="form-control mt-2">
                        <button type="submit" class="btn btn-primary w-full">
                            @SharedLocalizer["ResetPasswordSubmit"]
                        </button>
                    </div>
                </form>

                <div class="divider my-4"></div>

                <p class="text-center text-sm text-base-content/80">
                    <a asp-page="/Account/Login" class="link link-primary font-medium">
                        @SharedLocalizer["GoToLogin"]
                    </a>
                </p>
            }
        </div>
    </div>
</div>
