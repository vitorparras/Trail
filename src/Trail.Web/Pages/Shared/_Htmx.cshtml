@using Microsoft.AspNetCore.Antiforgery
@using Trail.Web.Htmx
@inject IAntiforgery Antiforgery
@{
    var tokens = Antiforgery.GetAndStoreTokens(Context);
}
<meta name="htmx-config" content="@HtmxIntegration.ClientConfiguration" />
<meta name="csrf-token" content="@tokens.RequestToken" data-header-name="@tokens.HeaderName" />
<script src="~/lib/htmx/htmx.min.js" defer></script>
<script src="~/js/htmx-integration.js" defer></script>
